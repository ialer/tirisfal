# docker/compose.yaml 的变量（复制为 .env 后生效）
# 服务只绑 EasyTier 虚拟 IP；不要写成 0.0.0.0
TIRISFAL_BIND_IP=100.100.1.1
# 内网访问名（EasyTier MagicDNS 里的 hostname，或自定义 DNS 记录）
TIRISFAL_HOST=tirisfal.local
# 宿主机映射端口（443 被占用时可改）
TIRISFAL_HTTPS_PORT=443
# 镜像：本地构建用 local，正式部署用 GHCR 上的版本 tag
TIRISFAL_IMAGE=ghcr.io/ialer/tirisfal:local
TZ=Asia/Shanghai

# 可选加固：设置后，worker 只信任带该共享密钥的请求（Caddy 侧同值注入）
# 注意：当前 Caddyfile 未注入该头，开启前需同步修改 Caddyfile
# PROXY_SHARED_SECRET=
