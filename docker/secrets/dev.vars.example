# 复制为 docker/secrets/dev.vars（chmod 600, chown 10001:10001），由容器挂载到 /run/secrets/dev.vars
# 生成：
#   openssl rand -hex 32      -> JWT_SECRET
#   openssl rand -base64 32   -> ENCRYPTION_KEY
# 注意：ENCRYPTION_KEY 一旦用于加密数据就不可更换（更换后旧密文无法解密）
# 下面是占位符，容器启动会直接拒绝；必须替换成真实随机值。
JWT_SECRET=REPLACE_ME_JWT_SECRET
ENCRYPTION_KEY=REPLACE_ME_ENCRYPTION_KEY
# 可选
# TOTP_SECRET=
# BACKUP_ENCRYPTION_KEY=
# OUTBOUND_DNS_GUARD=0
